# ——— Store WhatsApp number (contact links on the site) ———
# International format, no "+" and no spaces
NEXT_PUBLIC_WHATSAPP_NUMBER=212664553194

# ——— Database (Neon Postgres) — Vercel: Storage → Neon, adds it automatically ———
DATABASE_URL=

# ——— Photos / voice notes uploaded from the admin (Vercel Blob) ———
# Vercel: Storage → Blob. Without it, local development saves uploads in public/uploads.
BLOB_READ_WRITE_TOKEN=

# ——— Admin dashboard (/admin) password ———
ADMIN_PASSWORD=

# Optional: public address, for the "Gérer dans le tableau de bord" link in Telegram
# (on Vercel the production domain is detected automatically)
# SITE_URL=https://www.example.ma

# ——— Orders sent in the background to Telegram ———
# 1. In Telegram, open @BotFather → /newbot → copy the token it gives you
TELEGRAM_BOT_TOKEN=
# 2. Open your new bot, press Start, then run: npm run telegram:chat-id
#    Several recipients (e.g. you + a colleague, or a group): comma-separated ids
TELEGRAM_CHAT_ID=

# If these are empty: in development orders are only printed in the terminal;
# in production orders are refused (the customer sees an error and can retry).
